# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/safelink?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email (SendGrid/Resend/Mailgun)
EMAIL_SERVER_HOST="smtp.sendgrid.net"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="your-sendgrid-api-key"
EMAIL_FROM="SafeLink <noreply@safelink.example.com>"

# Maps
NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token"
# OR for Leaflet/OpenStreetMap (no token needed)

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SafeLink"

# Realtime
SOCKET_IO_URL="http://localhost:3001"

# Security
ENCRYPTION_KEY="your-32-char-encryption-key-here"
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000